# Copy to .env.local and fill in. Never commit .env.local.

# Admin sign-in (Auth.js). AUTH_SECRET signs the session cookie:
#   openssl rand -base64 32
AUTH_SECRET=
# The shared admin account. Generate the hash with:
#   npm run admin:password -- "your password"
# In .env.local every `$` in the hash must be written `\$` (the script does this).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD_HASH=

# Hosted store, option 1 (what is deployed): Postgres on Neon, added through Vercel's
# Marketplace — it sets DATABASE_URL. Uploaded files are kept in the database.
DATABASE_URL=
# DATABASE_SCHEMA=country_index

# Hosted store, option 2 (TECH_SPEC §6–7) (both, or neither — without them the admin uses local files in .data/admin).
# MongoDB Atlas: a database user scoped to this database only, strong generated password.
MONGODB_URI=
MONGODB_DB=country_index
# Azure Storage: a PRIVATE container (no anonymous access). Connection string from the
# storage account's "Access keys".
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=index-uploads

# Public site
SHOW_SAMPLE_DATA_BANNER=true

# Admin console
# Show the demonstration versions (fictional records) instead of the local store.
ADMIN_DEMO_DATA=false
# Time zone for every timestamp in the console (IANA name).
ADMIN_TIME_ZONE=UTC
# Update workflow — both await the client's decision (lib/admin/workflow.ts).
# A second administrator (not the uploader) approves a version before it can be published.
ADMIN_REQUIRE_APPROVAL=false
# Allow publishing an earlier version again (rollback).
ADMIN_ALLOW_ROLLBACK=true

# Review link (/share/<SHARE_TOKEN>): shows one version, in preview, to anyone with the link.
# Generate both with `npm run share:link` (written to .data/share/, git-ignored). Change the
# token to revoke the link. Leave empty to turn sharing off.
SHARE_TOKEN=
SHARE_PAYLOAD=
